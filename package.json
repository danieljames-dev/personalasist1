{
  "name": "aion-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Project AION platform workspace",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run career:test && npm run aion:server:test",
    "test:backup-refs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-backup-ref-policy.ps1",
    "control-plane:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-control-plane.ps1",
    "control-plane:test-collections": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-control-plane-collections.ps1",
    "control-plane:test-real-gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-control-plane-real-gate.ps1",
    "privacy-boundary:test": "npm run test --workspace @aion/privacy-boundary && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-privacy-boundary.ps1",
    "identity:build": "npm run build --workspace @aion/privacy-boundary && npm run build --workspace @aion/identity",
    "identity:typecheck": "npm run typecheck --workspace @aion/identity",
    "identity:test": "npm run test --workspace @aion/identity",
    "identity:test:unit": "npm run test:unit --workspace @aion/identity",
    "identity:test:persistence": "npm run test:persistence --workspace @aion/identity",
    "identity:test:cli": "npm run test:cli --workspace @aion/identity",
    "identity:initialize": "npm run identity:build --silent && node apps/identity-cli.mjs initialize",
    "identity:status": "npm run identity:build --silent && node apps/identity-cli.mjs status",
    "identity:export": "npm run identity:build --silent && node apps/identity-cli.mjs export",
    "object:build": "npm run build --workspace @aion/object",
    "object:typecheck": "npm run typecheck --workspace @aion/object",
    "object:test": "npm run test --workspace @aion/object",
    "object:test:unit": "npm run test:unit --workspace @aion/object",
    "object:test:canonical": "npm run test:canonical --workspace @aion/object",
    "object:test:repository": "npm run test:repository --workspace @aion/object",
    "object:test:families": "npm run test:families --workspace @aion/object",
    "object:test:relationships": "npm run test:relationships --workspace @aion/object",
    "object:test:operations": "npm run test:operations --workspace @aion/object",
    "object:test:limits": "npm run test:limits --workspace @aion/object",
    "object:test:architecture": "npm run test:architecture --workspace @aion/object",
    "career-input:build": "npm run build --workspace @aion/career-input",
    "career-input:typecheck": "npm run typecheck --workspace @aion/career-input",
    "career-input:test": "npm run test --workspace @aion/career-input",
    "career-input:test:unit": "npm run test:unit --workspace @aion/career-input",
    "career-input:test:preflight": "npm run test:preflight --workspace @aion/career-input",
    "career-input:test:templates": "npm run test:templates --workspace @aion/career-input",
    "career-input:test:architecture": "npm run test:architecture --workspace @aion/career-input",
    "career-evidence:build": "npm run build --workspace @aion/career-evidence",
    "career-evidence:typecheck": "npm run typecheck --workspace @aion/career-evidence",
    "career-evidence:test": "npm run test --workspace @aion/career-evidence",
    "career-evidence:test:unit": "npm run test:unit --workspace @aion/career-evidence",
    "career-evidence:test:catalogue": "npm run test:catalogue --workspace @aion/career-evidence",
    "career-evidence:test:facts": "npm run test:facts --workspace @aion/career-evidence",
    "career-evidence:test:profile": "npm run test:profile --workspace @aion/career-evidence",
    "career-evidence:test:operations": "npm run test:operations --workspace @aion/career-evidence",
    "career-evidence:test:persistence": "npm run test:persistence --workspace @aion/career-evidence",
    "career-evidence:test:architecture": "npm run test:architecture --workspace @aion/career-evidence",
    "job-posting:build": "npm run build --workspace @aion/job-posting",
    "job-posting:typecheck": "npm run typecheck --workspace @aion/job-posting",
    "job-posting:test": "npm run test --workspace @aion/job-posting",
    "job-posting:test:unit": "npm run test:unit --workspace @aion/job-posting",
    "job-posting:test:structured": "npm run test:structured --workspace @aion/job-posting",
    "job-posting:test:text": "npm run test:text --workspace @aion/job-posting",
    "job-posting:test:currentness": "npm run test:currentness --workspace @aion/job-posting",
    "job-posting:test:operations": "npm run test:operations --workspace @aion/job-posting",
    "job-posting:test:persistence": "npm run test:persistence --workspace @aion/job-posting",
    "job-posting:test:architecture": "npm run test:architecture --workspace @aion/job-posting",
    "job-matching:build": "npm run build --workspace @aion/job-matching",
    "job-matching:typecheck": "npm run typecheck --workspace @aion/job-matching",
    "job-matching:test": "npm run test --workspace @aion/job-matching",
    "job-matching:test:unit": "npm run test:unit --workspace @aion/job-matching",
    "job-matching:test:operations": "npm run test:operations --workspace @aion/job-matching",
    "job-matching:test:architecture": "npm run test:architecture --workspace @aion/job-matching",
    "application-preparation:build": "npm run build --workspace @aion/application-preparation",
    "application-preparation:typecheck": "npm run typecheck --workspace @aion/application-preparation",
    "application-preparation:test": "npm run test --workspace @aion/application-preparation",
    "application-preparation:test:unit": "npm run test:unit --workspace @aion/application-preparation",
    "application-preparation:test:operations": "npm run test:operations --workspace @aion/application-preparation",
    "application-preparation:test:architecture": "npm run test:architecture --workspace @aion/application-preparation",
    "career:build": "npm run application-preparation:build",
    "career:init": "npm run career:build && node apps/career-cli.mjs init",
    "career:ingest": "npm run career:build && node apps/career-cli.mjs ingest",
    "career:profile": "npm run career:build && node apps/career-cli.mjs profile",
    "career:job:import": "npm run career:build && node apps/career-cli.mjs job:import",
    "career:match": "npm run career:build && node apps/career-cli.mjs match",
    "career:draft": "npm run career:build && node apps/career-cli.mjs draft",
    "career:export": "npm run career:build && node apps/career-cli.mjs export",
    "career:demo": "npm run career:build && node apps/career-cli.mjs demo",
    "career:test": "npm run career:build && node --test \"test/career-cli/**/*.test.mjs\"",
    "aion:build": "npm run build --workspace @aion/local-assistant",
    "aion": "npm run aion:build --silent && node apps/aion-command-center.mjs",
    "aion:test": "npm run test --workspace @aion/local-assistant && npm run aion:server:test",
    "aion:server:test": "npm run aion:build --silent && node --test \"test/aion/**/*.test.mjs\"",
    "aion:demo": "npm run career:build --silent && npm run aion:build --silent && node apps/aion-demo.mjs",
    "verify": "npm run typecheck && npm test",
    "aion:sales:demo": "npm run aion:build --silent && node apps/aion-sales-demo.mjs",
    "aion:v12:demo": "npm run aion:build --silent && node apps/aion-v12-demo.mjs",
    "aion:v13:demo": "npm run aion:build --silent && node apps/aion-v13-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
