{
  "name": "@aion/delegated-operator",
  "version": "0.1.0",
  "description": "R6.5 administrative delegated-operator control plane (inactive by default; Founder remains authoritative)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:test && node --test --test-reporter=tap \"dist-test/test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "test:architecture": "npm run build && node --test --test-reporter=tap \"test/architecture-boundary.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
