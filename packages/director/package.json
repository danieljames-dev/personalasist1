{
  "name": "@aion/director",
  "version": "0.1.0",
  "description": "Mission orchestration for AION engineering work — deterministic state, durable events, and authority that models cannot widen",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./executor-adapters": {
      "types": "./dist/executor-adapters.d.ts",
      "import": "./dist/executor-adapters.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "build:local-assistant": "npm --prefix ../local-assistant run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:local-assistant && npm run build:test && node --test --test-reporter=tap \"dist-test/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
