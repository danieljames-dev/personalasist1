  "schema": "aion.director.acceptance.work-items.v1",
  "addendum": "OWNER_GATES_ARE_LOCAL_DEPENDENCY_BLOCKS",
  "clarifiedBeforeClaudeFinalSha": true,
  "principle": "An unresolved Owner gate blocks only work that actually depends on that gate. It must not automatically freeze the entire mission while unrelated authorized work remains ready.",
  "relationshipToMissionStates": "WAITING_FOR_OWNER is the mission presentation when every remaining unfinished work item is blocked on an Owner gate. Opening a gate does not, by itself, globally idle a mission that still has independent READY or RUNNING work.",
  "rules": {
    "gateBlocksOnlyDependents": true,
    "unrelatedReadyWorkMayContinue": true,
    "waitingForOwnerOnlyWhenNoIndependentReadyOrRunningWork": true,
    "globalPauseOverridesReadyWork": true,
    "leaseCollisionSerializesExclusiveResources": true,
    "nonconflictingReadyWorkMayRunInParallel": true,
    "highConsequenceCannotBypassByRelabel": true,
    "trustedOwnerProvenanceRequiredToResolve": true,
    "doNotRequireHighThroughput": true
  },
  "trustedResolutionProvenance": ["OWNER_DIRECTIVE"],
  "highConsequenceKinds": [
    "SPEND",
    "OAUTH",
    "PUBLIC_EXPOSURE",
    "DESTRUCTIVE",
    "PRODUCTION_DEPLOY"
  ],
  "kindToRequiredGate": {
    "SPEND": "SPEND_APPROVAL_REQUIRED",
    "OAUTH": "OAUTH_REQUIRED",
    "PUBLIC_EXPOSURE": "PUBLIC_EXPOSURE_APPROVAL_REQUIRED",
    "DESTRUCTIVE": "DESTRUCTIVE_ACTION_APPROVAL_REQUIRED",
    "PRODUCTION_DEPLOY": "PRODUCTION_DEPLOY_APPROVAL_REQUIRED",
    "PHYSICAL_DEVICE_TEST": "PHYSICAL_IPHONE_TEST_REQUIRED"
  },
